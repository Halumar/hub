{
  "description": "A profile without a stored panel_remote (copied before the panel rules existed) keeps the catalog default on – the hub never rewrites existing profiles; the sensors come from the catalog default too.",
  "input": {
    "platform": "ipados",
    "access": {
      "kind": "member",
      "expires_at": null
    },
    "profile": {
      "rules": {
        "kiosk": true
      }
    },
    "device": {
      "own_area_id": null,
      "has_remote_pin": false
    },
    "now": "2026-11-20T18:00:00Z"
  },
  "expected": {
    "panel_remote": {
      "value": true,
      "source": "default",
      "reason": "catalog_default",
      "locked": true,
      "fixed": false,
      "user_choice": false,
      "expires_at": null,
      "then": null,
      "enforcement": "hub"
    },
    "panel_sensors": {
      "value": [
        "battery",
        "charging",
        "screen",
        "brightness"
      ],
      "source": "default",
      "reason": "catalog_default",
      "locked": true,
      "fixed": false,
      "user_choice": false,
      "expires_at": null,
      "then": null,
      "enforcement": "hub"
    }
  }
}
