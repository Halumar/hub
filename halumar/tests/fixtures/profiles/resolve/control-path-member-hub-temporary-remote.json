{
  "description": "A person on Hub only with remote access for one hour: quick access and the watch are lifted only that long; both carry the end of the remote access and the value once the boundary applies again.",
  "input": {
    "platform": "ios",
    "access": {
      "kind": "member",
      "expires_at": null
    },
    "profile": {
      "from_suggestion": "adult",
      "rules": {
        "control_path": "hub",
        "remote_access": false
      }
    },
    "device": {
      "own_area_id": null,
      "has_remote_pin": false
    },
    "now": "2026-11-20T18:00:00Z",
    "overrides": [
      {
        "rule": "remote_access",
        "value": true,
        "expires_at": "2026-11-20T19:00:00Z"
      }
    ]
  },
  "expected": {
    "control_path": {
      "value": "hub",
      "source": "profile",
      "reason": "profile",
      "locked": true,
      "fixed": false,
      "enforcement": "hub"
    },
    "remote_access": {
      "value": true,
      "source": "device",
      "reason": "device_temporary",
      "locked": true,
      "fixed": false,
      "expires_at": "2026-11-20T19:00:00Z",
      "then": false,
      "enforcement": "ha"
    },
    "quick_access": {
      "value": "control",
      "source": "profile",
      "reason": "profile",
      "locked": true,
      "fixed": false,
      "expires_at": "2026-11-20T19:00:00Z",
      "then": "off",
      "enforcement": "app"
    },
    "watch": {
      "value": true,
      "source": "profile",
      "reason": "profile",
      "locked": true,
      "fixed": false,
      "expires_at": "2026-11-20T19:00:00Z",
      "then": false,
      "enforcement": "hub"
    }
  },
  "expected_ha_user_group": "read_only"
}
