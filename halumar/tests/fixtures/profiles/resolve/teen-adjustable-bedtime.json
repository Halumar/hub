{
  "description": "Teen with bedtime made adjustable per device (not fixed): one device goes to bed later.",
  "input": {
    "platform": "ios",
    "access": {
      "kind": "member",
      "expires_at": null
    },
    "profile": {
      "from_suggestion": "teen",
      "fixed": [
        "kids_blocked_types",
        "kids_color_lock",
        "kids_exceptions",
        "kids_rate_limit",
        "kids_volume_max"
      ]
    },
    "overrides": [
      {
        "rule": "kids_quiet_hours",
        "value": [
          {
            "days": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri"
            ],
            "start": "22:30",
            "end": "06:00"
          }
        ]
      }
    ],
    "device": {
      "own_area_id": null,
      "has_remote_pin": true
    },
    "now": "2026-11-20T18:00:00Z"
  },
  "expected": {
    "kids_quiet_hours": {
      "value": [
        {
          "days": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri"
          ],
          "start": "22:30",
          "end": "06:00"
        }
      ],
      "source": "device",
      "reason": "device",
      "locked": true,
      "fixed": false,
      "enforcement": "hub"
    },
    "kids_volume_max": {
      "value": 80,
      "source": "profile",
      "reason": "profile",
      "locked": true,
      "fixed": true,
      "enforcement": "hub"
    }
  }
}
