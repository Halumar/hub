{
  "description": "Device adjustment panel_brightness lux with a Home Assistant illuminance sensor and log curve.",
  "input": {
    "platform": "ipados",
    "access": {
      "kind": "member",
      "expires_at": null
    },
    "profile": {
      "from_suggestion": "wall_panel"
    },
    "overrides": [
      {
        "rule": "panel_brightness",
        "value": {
          "mode": "lux",
          "lux_entity": "sensor.living_room_illuminance",
          "min": 10,
          "max": 90,
          "lux_max": 400,
          "curve": "log"
        }
      }
    ],
    "device": {
      "own_area_id": null,
      "has_remote_pin": false
    },
    "now": "2026-11-20T18:00:00Z"
  },
  "expected": {
    "panel_brightness": {
      "value": {
        "mode": "lux",
        "lux_entity": "sensor.living_room_illuminance",
        "min": 10,
        "max": 90,
        "lux_max": 400,
        "curve": "log"
      },
      "source": "device",
      "reason": "device",
      "locked": true,
      "fixed": false,
      "enforcement": "app"
    }
  }
}
