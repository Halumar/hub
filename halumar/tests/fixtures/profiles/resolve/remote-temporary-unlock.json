    }
  },
  "entity_checks": [
    {
      "entity_id": "lock.front_door",
      "device_class": null,
      "route": "external",
      "quick_access": "control",
      "expected_app": "control",
      "expected_quick": "control",
      "expected_always_visible": false
    },
    {
      "entity_id": "lock.back_door",
      "device_class": null,
      "route": "external",
      "quick_access": "control",
      "expected_app": "view",
      "expected_quick": "status",
      "expected_always_visible": false
