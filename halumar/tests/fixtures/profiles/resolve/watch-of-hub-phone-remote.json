    },
    "device": {
      "own_area_id": null,
      "has_remote_pin": false
    },
    "now": "2026-11-20T18:00:00Z",
    "limit": {
      "platform": "ios",
      "access": {
        "kind": "member",
        "expires_at": null
      },
      "profile": {
        "from_suggestion": "adult",
